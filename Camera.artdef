	<m_TemplateName text="Camera"/>
	<m_RootCollections>
		<Element>
			<m_CollectionName text="Cameras"/>
			<Element>
				<m_Fields>
					<m_Values>
						<Element class="AssetObjects::FloatValue">
							<m_fValue>2.000000</m_fValue>
							<m_ParamName text="DefaultZoom"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<m_fValue>0.110000</m_fValue>
							<m_ParamName text="Bloom_Width"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<m_fValue>0.600000</m_fValue>
							<m_ParamName text="Bloom_Strength"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<m_fValue>1.000000</m_fValue>
							<m_ParamName text="Bloom_Threshold"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<m_fValue>1.000000</m_fValue>
							<m_ParamName text="ExtraExposureRange"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<!-- How far in you can zoom the Strategy map. Lower numbers give closer zoom. Default was 3. -->
							<m_fValue>6.000000</m_fValue>
							<m_ParamName text="MinHexesVisible"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<!-- How far out you can zoom the Strategy Map. Higher numbers give farther zoom. Default was 16. -->
							<m_fValue>32.000000</m_fValue>
							<m_ParamName text="MaxHexesVisible"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<m_fValue>10.000000</m_fValue>
							<m_ParamName text="NearClip"/>
						</Element>
						<Element class="AssetObjects::FloatValue">
							<m_fValue>10000.000000</m_fValue>
							<m_ParamName text="FarClip"/>
						</Element>
					</m_Values>
				</m_Fields>
				<m_ChildCollections>
					<Element>
						<m_CollectionName text="FOVCurve"/>
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>0.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>45.000000</m_fValue>
										<m_ParamName text="FOV"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="FOVCurve001"/>
						</Element>
					</Element>
					<Element>
						<m_CollectionName text="TiltCurve"/>
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>100.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- Camera tilt at farthest zoom. Lower values make it more two-dimensional (like a map on a wall). Default was 45. -->
										<m_fValue>10.000000</m_fValue>
										<m_ParamName text="Tilt"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="TiltCurve1"/>
						</Element>
						<!-- Inserted this node to dramatically increase the tilt (more "3D" immersion) when you approach maximum zoom. -->
						<!-- We're essentially squeezing the game's stock zoom behavior into the closest 30% of zoom range. -->
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>30.000000</m_fValue> <!-- Put the "closeup" threshold at 30% zoom -->
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>45.000000</m_fValue> <!-- Camera tilt amount at 30% zoom -->
										<m_ParamName text="Tilt"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="TiltCurve1.5"/> <!-- Can name this whatever you want, as long as it's unique -->
						</Element>
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>0.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
										<Element class="AssetObjects::FloatValue">
										<!-- Camera tilt at closest zoom.  Higher values make you look more toward the horizon. Default was 55. -->
										<!-- Note values above 65 can start to show artifacts at edges of map (at least when combined with low altitudes in the next sections). -->
										<!-- To make it work like shown in the video, change this to 70; or to avoid clipping keep it at 65. -->
										<m_fValue>65.000000</m_fValue>
										<m_ParamName text="Tilt"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="TiltCurve2"/>
						</Element>
					</Element>
					<Element>
						<m_CollectionName text="HeightCurve"/>
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>100.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- Altitude at furthest zoom in WorldView map. Default was 600. -->
										<m_fValue>2500.000000</m_fValue>
										<m_ParamName text="Height"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="HeightCurve2"/>
						</Element>
						<!-- Inserted this node, corresponding to the "closeup" zoom threshold. -->
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>30.000000</m_fValue> <!-- Threshold is at 30% zoom -->
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- Altitude at 30% zoom.  Note 600 corresponds to the furthest zoom out altitude of stock game. -->
										<m_fValue>600.000000</m_fValue>
										<m_ParamName text="Height"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="HeightCurve1.5"/>
						</Element>
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>0.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- Altitude at closest zoom in WoldView map. Default is 120. -->
										<!-- Note lowering this to 40, and changing the closest zoom tilt value to 70, can really put you -->
										<!-- in the action, but unfortunately would create some clipping artifacts near edges of map. -->
										<!-- Close-up preset: 14 = ~35% of the camera-to-focus distance of 40 (tilt and FOV untouched). Raise toward 20-40 if terrain/edge clipping appears. -->
										<m_fValue>14.000000</m_fValue>
										<m_ParamName text="Height"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="HeightCurve1"/>
						</Element>
					</Element>
					<Element>
						<m_CollectionName text="Fog_Density"/>
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>0.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- Fog density at closest zoom. Default is 0.000500 -->
										<m_fValue>0.000800</m_fValue>
										<m_ParamName text="Fog_Density"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="Fog_Density002"/>
						</Element>
						<!-- Inserted this node to eliminate fog above the "closeup" zoom threshold. -->
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<!-- Zoom threshold at which to start displaying fog -->
										<m_fValue>20.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- Fog density at 20% zoom -->
										<m_fValue>0.000000</m_fValue>
										<m_ParamName text="Fog_Density"/>
									</Element>
								</m_Values>
							</m_Fields>
							<m_ChildCollections/>
							<m_Name text="Fog_Density001.5"/>
						</Element>
					</Element>
					<Element>
						<m_CollectionName text="Fog_Start"/>
						<!-- Could eliminate this element since fog density is 0 from 30% to 100% zoom -->
						<Element>
							<m_Fields>
								<m_Values>
									<Element class="AssetObjects::FloatValue">
										<m_fValue>100.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- How far from camera center fog starts(?), at farthest zoom.  Default is 1000. -->
										<m_fValue>2500.000000</m_fValue>
										<m_ParamName text="Fog_Start"/>
									</Element>
								</m_Values>
							</m_Fields>
