										<m_fValue>30.000000</m_fValue>
										<m_ParamName text="Time"/>
									</Element>
									<Element class="AssetObjects::FloatValue">
										<!-- How far from camera center fog starts(?), at zoom given threshold.  Default is 700. -->
										<m_fValue>1000.000000</m_fValue>
